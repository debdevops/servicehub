# ServiceHub — environment file for `docker compose up`.
#
# Copy this file to `.env` and fill in the two secrets below, then run:
#
#   cp .env.example .env
#   printf 'SECURITY__ENCRYPTIONKEY=%s\n' "$(openssl rand -hex 32)" >> .env
#   printf 'SECURITY__SPATOKEN__SECRET=%s\n' "$(openssl rand -hex 32)" >> .env
#   docker compose up --build
#
# `.env` is gitignored. Never commit real values.

# ---------------------------------------------------------------------------
# REQUIRED — docker compose refuses to start without these.
# ---------------------------------------------------------------------------

# Encrypts every stored namespace connection string at rest (AES-GCM-256).
# Must be exactly 64 hexadecimal characters (32 bytes). Generate with:
#   openssl rand -hex 32
#
# This key is NOT rotatable: changing it after namespaces have been saved makes
# every previously stored connection string permanently undecryptable, and those
# namespaces must be re-entered. Treat it as fixed for the life of your data, and
# generate a distinct key per deployment.
SECURITY__ENCRYPTIONKEY=

# Signs the SPA token embedded in the served HTML page. Must be at least 32
# characters. Generate with:
#   openssl rand -hex 32
#
# This confirms a request came from the page ServiceHub served — it does not
# identify or authenticate a user. For per-user identity, configure Security:Oidc
# or Azure Easy Auth (see self-hosting/README.md).
SECURITY__SPATOKEN__SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — sensible defaults are applied in docker-compose.yml.
# ---------------------------------------------------------------------------

# The URL users actually visit. Used for CORS and SPA token validation.
# Defaults to http://localhost:8080 when unset.
#SITEURL=http://localhost:8080

# Preview providers. Azure is the only live provider unless a flag is enabled.
# See self-hosting/README.md for least-privilege IAM setup per provider.
#CLOUDPROVIDERS__AWS__ENABLED=true
#CLOUDPROVIDERS__GCP__ENABLED=true
