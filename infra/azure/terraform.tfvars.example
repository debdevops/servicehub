# Copy to terraform.tfvars and fill in. No secret belongs in this file.
subscription_id  = "00000000-0000-0000-0000-000000000000"
region           = "westeurope"
ssh_public_key   = "ssh-ed25519 AAAA... you@example"
allowed_ssh_cidr = "203.0.113.7/32" # your own address: curl -s https://api.ipify.org

# Optional
# name                    = "servicehub"
# servicehub_version      = "4.2.0"
# vm_size                 = "Standard_B2s"
# data_disk_gb            = 32
# snapshot_retention_days = 7
# backup_retention_days   = 30
