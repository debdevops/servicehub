<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ServiceHub.Infrastructure — persistence, the ledger, the eligibility gate, the agent host,
    the event bus, webhooks and secret protection. Depends on Core only.

    It must NEVER reference a ServiceHub.Providers.* project: the composition root in
    ServiceHub.Api is the one place the three clouds and the infrastructure meet.
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!-- Transitive of EF Core SQLite; pinned forward past GHSA-2m69-gcr7-jv3q. -->
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="2.1.12" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.10" />
    <PackageReference Include="Polly.Core" Version="8.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceHub.Core\ServiceHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceHub.UnitTests" />
  </ItemGroup>

</Project>
