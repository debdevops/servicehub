<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <VersionFile>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '..', '..', '..', '..', '.version'))</VersionFile>
    <Version>$([System.IO.File]::ReadAllText($(VersionFile)).Trim())</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>14.0</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591;NU1510</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="2.22.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.16.10" />
    <!-- Swashbuckle for Swagger UI -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Explicit dependency override to fix vulnerability (CVE-2026-49451 / GHSA-v5pm-xwqc-g5wc) in transitively referenced Microsoft.OpenApi 2.4.1 -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- AspNetCore.HealthChecks.UI.Client: no .NET 10 release yet; 9.0.0 is the latest compatible version -->
    <PackageReference Include="AspNetCore.HealthChecks.UI.Client" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceHub.Core\ServiceHub.Core.csproj" />
    <ProjectReference Include="..\ServiceHub.Infrastructure\ServiceHub.Infrastructure.csproj" />
    <ProjectReference Include="..\ServiceHub.Shared\ServiceHub.Shared.csproj" />
    <ProjectReference Include="..\ServiceHub.Simulator\ServiceHub.Simulator.csproj" />
  </ItemGroup>

</Project>
