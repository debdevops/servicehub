<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    ServiceHub.Api — controllers, middleware and the composition root. This is the ONLY project
    that references both ServiceHub.Infrastructure and the ServiceHub.Providers.* projects.

    A controller validates, delegates, maps a Result to HTTP, and stops. Business rules live below.
  -->

  <PropertyGroup>
    <!-- The SPA build writes here (apps/servicehub/vite.config.ts). It is git-ignored: in 4.0.0
         this folder was tracked, so every local build dirtied the tree. -->
    <SpaRoot>wwwroot</SpaRoot>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive of Microsoft.AspNetCore.OpenApi; pinned forward past GHSA-v5pm-xwqc-g5wc. -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <!-- Design-time only: powers `dotnet ef migrations add` against ServiceHubDbContext in ServiceHub.Infrastructure -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ServiceHub.Core\ServiceHub.Core.csproj" />
    <ProjectReference Include="..\ServiceHub.Infrastructure\ServiceHub.Infrastructure.csproj" />
    <ProjectReference Include="..\ServiceHub.Providers.Azure\ServiceHub.Providers.Azure.csproj" />
    <ProjectReference Include="..\ServiceHub.Providers.Aws\ServiceHub.Providers.Aws.csproj" />
    <ProjectReference Include="..\ServiceHub.Providers.Gcp\ServiceHub.Providers.Gcp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceHub.UnitTests" />
    <InternalsVisibleTo Include="ServiceHub.IntegrationTests" />
  </ItemGroup>

</Project>
