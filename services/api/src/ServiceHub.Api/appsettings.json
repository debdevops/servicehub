{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ServiceHub": "Information"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "",
    "EnableAdaptiveSampling": true,
    "SamplingPercentage": 50,
    "MaxTelemetryItemsPerSecond": 5
  },
  "AllowedHosts": "localhost",
  
  // SECURITY: no "AllowedOrigins" key here on purpose. This base file is loaded by every
  // environment, and .NET config layering flattens arrays into indexed keys that an empty
  // array in an environment-specific file (e.g. appsettings.Production.json) cannot clear —
  // so a default here would leak into Production/Staging regardless of what they set.
  "Cors": {
    "DevelopmentDefaults": [
      "http://localhost:3000",
      "http://localhost:5173",
      "http://localhost:5174",
      "https://localhost:3000",
      "https://localhost:5173",
      "https://localhost:5174"
    ]
  },

  "HttpHeaders": {
    "CorrelationId": "X-Correlation-Id",
    "RateLimitLimit": "X-RateLimit-Limit",
    "RateLimitRemaining": "X-RateLimit-Remaining",
    "RateLimitReset": "X-RateLimit-Reset",
    "TotalCount": "X-Total-Count",
    "PageNumber": "X-Page-Number",
    "PageSize": "X-Page-Size"
  },

  "SecurityHeaders": {
    "Enabled": true,
    "ContentTypeOptions": "nosniff",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "XssProtection": "1; mode=block",
    "ContentSecurityPolicyProduction": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'",
    "ContentSecurityPolicyDevelopment": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; frame-ancestors 'none'",
    "PermissionsPolicy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
    "StrictTransportSecurity": "max-age=31536000; includeSubDomains",
    "ApiVersion": "1.0"
  },
  
  "ServiceBus": {
    "ConnectionCacheExpirationMinutes": 60,
    "MaxConcurrentCalls": 10,
    "PrefetchCount": 100,
    "DefaultTimeout": "00:01:00",
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "MaxRetryDelayMs": 30000
  },
  
  "Security": {
    "EncryptionKey": "CHANGE_THIS_IN_PRODUCTION_USE_ENV_VAR",
    "EnableConnectionStringEncryption": true,
    "Authentication": {
      "Enabled": true,
      "ApiKeys": []
    },
    "Headers": {
      "Enabled": true
    }
  },

  "RateLimit": {
    "MaxRequests": 300,
    "WindowDuration": "00:01:00"
  },

  "CloudProviders": {
    "Aws": {
      "Enabled": false
    },
    "Gcp": {
      "Enabled": false
    }
  },

  "DlqDatabase": {
    // SQLite hardening (roadmap F1): busy_timeout for the driver's own internal wait when a
    // write hits another connection's lock, and the retry count for the outer Polly wrapper
    // that catches SQLITE_BUSY/SQLITE_LOCKED if contention outlasts that wait. WAL journal
    // mode is always applied and is not configurable.
    "BusyTimeoutMilliseconds": 5000,
    "MaxBusyRetryAttempts": 3,

    "HealthCheck": {
      // Basic DB observability (roadmap §8 F-track item 4). A WAL file that stays above this
      // size rather than oscillating back down after each checkpoint indicates checkpointing
      // is falling behind the eight background workers writing to this database.
      "WalSizeWarningThresholdBytes": 67108864,
      // The health check's own round-trip time against the live database — the closest
      // deterministic equivalent SQLite has to a slow-query log.
      "SlowCheckThresholdMilliseconds": 500
    }
  },

  "Backup": {
    // Backup & Restore (roadmap F2). ScheduledBackupIntervalHours is 0 (off) by default — an
    // on-demand backup is always available via POST /api/v1/admin/backup regardless of this
    // setting. Set a positive value here to opt in to scheduled backups.
    "ScheduledBackupIntervalHours": 0,
    "RetentionCount": 14
  },

  "DlqMonitor": {
    "AllowDestructivePeek": {
      "Aws": false
    },
    "PollIntervalSeconds": 10,
    "MaxParallelScans": 10,
    "MaxRuleEvaluationBatch": 500
  },

  "RecoveryEvidence": {
    "StampReplayMarker": true,
    "ObservationWindowHours": 24.0,
    "VerificationSweepIntervalSeconds": 60,
    "AgeingSweepIntervalSeconds": 3600,
    "AgeingThresholdDays": 7,
    "FleetReplayVelocityCapPerHour": 500,
    "CircuitBreakerSampleSize": 20,
    "CircuitBreakerSuccessRateFloor": 0.50,
    "MaxAgeingBatchSize": 1000,
    "MaxSignatureSweepBatchSize": 1000
  },

  "AI": {
    "Enabled": false,
    "ServiceUrl": "http://servicehub-ai:8000",
    "TimeoutSeconds": 5
  },

  "ReasoningAgent": {
    "Enabled": false,
    "ServiceUrl": "http://servicehub-agent:8010",
    "TimeoutSeconds": 30,
    "SweepIntervalMinutes": 60,
    "MaxSignaturesPerSweep": 3
  },

  "HealthChecks": {
    "Enabled": true,
    "CacheDurationSeconds": 30
  },

  "Webhooks": {
    "Enabled": false,
    "Url": "",
    "DlqSpikeThreshold": 10,
    "CooldownSeconds": 300
  },

  "Swagger": {
    "Title": "ServiceHub API",
    "Version": "v1",
    "Description": "Self-hosted forensic debugger for cloud message queues — Azure Service Bus, AWS SQS/SNS (preview), and GCP Pub/Sub (preview)."
  }
}
