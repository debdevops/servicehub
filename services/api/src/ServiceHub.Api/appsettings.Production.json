{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "ServiceHub": "Information"
    }
  },
  "ApplicationInsights": {
    "ConnectionString": "SET_VIA_ENV_VAR",
    "EnableAdaptiveSampling": true,
    "SamplingPercentage": 33,
    "MaxTelemetryItemsPerSecond": 5
  },

  // Host-header allow-list enforced by ASP.NET Core host filtering. Set to your
  // deployment hostname(s) via the AllowedHosts environment variable, e.g.
  // AllowedHosts="app.contoso.com;www.contoso.com". Never use "*" in production —
  // it disables host-header filtering (host-header injection / cache poisoning).
  "AllowedHosts": "SET_VIA_ENV_VAR",

  "SiteUrl": "SET_VIA_ENV_VAR",

  "Cors": {
    "AllowedOrigins": []
  },

  "Security": {
    "EncryptionKey": "SET_VIA_ENV_VAR",
    "EnableConnectionStringEncryption": true,
    "SpaToken": {
      "Enabled": true,
      "Secret": "SET_VIA_ENV_VAR"
    },
    "Authentication": {
      "Enabled": true,
      "ApiKeys": [],
      "ScopedApiKeys": [
        {
          "Key": "SET_VIA_ENV_VAR_Security__Authentication__ScopedApiKeys__0__Key",
          "Scopes": [],
          "Description": "Admin key (all scopes) — set via environment variable"
        },
        {
          "Key": "SET_VIA_ENV_VAR_Security__Authentication__ScopedApiKeys__1__Key",
          "Scopes": [
            "namespaces:read",
            "queues:read",
            "topics:read",
            "subscriptions:read",
            "messages:peek",
            "dlq:read",
            "anomalies:read"
          ],
          "Description": "Read-only key — set via environment variable"
        }
      ]
    },
    "EasyAuth": {
      "Enabled": true,
      "TrustClientPrincipalHeader": false,
      "Description": "Azure App Service Easy Auth. X-MS-CLIENT-PRINCIPAL-ID is only trusted when Azure Easy Auth is detected on the worker (WEBSITE_AUTH_ENABLED=True). On non-Azure hosts the header is ignored unless TrustClientPrincipalHeader is explicitly true AND your front end strips and injects it."
    },
    "Oidc": {
      "Enabled": false,
      "Authority": "SET_VIA_ENV_VAR_Security__Oidc__Authority",
      "Audience": "SET_VIA_ENV_VAR_Security__Oidc__Audience",
      "ClockSkewSeconds": 120,
      "Description": "Provider-neutral per-user SSO for any OIDC identity provider (Entra ID, Okta, Auth0, Ping, Google Workspace, ...) — works on any host, unlike EasyAuth above which is Azure App Service only. Off by default: set Enabled=true plus your IdP's Authority and this app's Audience (client ID) to accept 'Authorization: Bearer <JWT>' requests as per-user identities."
    },
    "Headers": {
      "Enabled": true
    }
  },

  "SecurityHeaders": {
    "Enabled": true,
    "ContentTypeOptions": "nosniff",
    "FrameOptions": "DENY",
    "ReferrerPolicy": "strict-origin-when-cross-origin",
    "XssProtection": "1; mode=block",
    "ContentSecurityPolicyProduction": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'",
    "PermissionsPolicy": "accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()",
    "StrictTransportSecurity": "max-age=31536000; includeSubDomains; preload"
  },

  "ServiceBus": {
    "ConnectionCacheExpirationMinutes": 60,
    "MaxConcurrentCalls": 10,
    "PrefetchCount": 100,
    "DefaultTimeout": "00:00:30",
    "RetryCount": 3,
    "RetryDelayMs": 1000,
    "MaxRetryDelayMs": 30000
  },

  "AI": {
    "Enabled": false
  },

  "RateLimit": {
    "MaxRequests": 60,
    "WindowDuration": "00:01:00"
  },

  "HealthChecks": {
    "Enabled": true,
    "CacheDurationSeconds": 60
  },

  "Swagger": {
    "Enabled": false
  },

  "DlqDatabase": {
    // Default: /var/servicehub/data on Linux, %LOCALAPPDATA%\ServiceHub\data on Windows.
    // Override with DlqDatabase__DataDirectory env var on your server.
    // Azure App Service: use /home/data (persistent storage mount).
    // AWS/GCP: use the path of any mounted persistent volume.
    "DataDirectory": "/var/servicehub/data"
  },

  "NamespaceRepository": {
    // Same override rules as DlqDatabase:DataDirectory above.
    "DataDirectory": "/var/servicehub/data"
  }
}
