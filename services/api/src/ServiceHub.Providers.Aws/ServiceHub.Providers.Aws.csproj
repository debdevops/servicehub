<Project Sdk="Microsoft.NET.Sdk">

  <!--
    ServiceHub.Providers.Aws — one cloud's adapter, a peer of the other two (ADR-0014 D5).
    Depends on Core and on its own cloud SDK. NEVER on ServiceHub.Infrastructure, and never on
    another provider. Adding a fourth cloud is a project like this one plus one registration line.
  -->

  <ItemGroup>
    <ProjectReference Include="..\ServiceHub.Core\ServiceHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.SQS" Version="3.7.400.35" />
    <PackageReference Include="AWSSDK.SimpleNotificationService" Version="3.7.400.35" />
    <PackageReference Include="AWSSDK.SecurityToken" Version="3.7.400.35" />
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.401" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
    <PackageReference Include="Polly.Core" Version="8.5.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ServiceHub.UnitTests" />
  </ItemGroup>

</Project>
