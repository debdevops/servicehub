<Project>

  <!--
    ServiceHub 4.1.0 — settings every project in the solution inherits.
    ADR-0014 D5: four kinds of project, one dependency direction, enforced by a test
    (ServiceHub.UnitTests/Architecture/DependencyDirectionTests.cs).
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- A warning left in place becomes a warning nobody reads. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <!--
      The analyser posture is deliberately not stricter than the default recommended set: code that
      has been proven against live cloud traffic should not be edited to satisfy a style rule.

      1591 — missing XML doc on a public member
      1574/1580/1584 — a doc cref to a type that does not exist yet. A stale doc link is not a
                       reason to edit proven code.
      NU1510 — an unprunable package reference
    -->
    <NoWarn>$(NoWarn);1591;1574;1580;1584;NU1510</NoWarn>

    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>

    <!--
      ONE source of version truth: the repository's .version file (ADR-0013 D6), which the SPA also
      reads through vite.config.ts. Two places to bump is how a footer and an API end up disagreeing
      about what is running.

      Unit 7.1 sets it to 4.1.0, which is the single edit that changes the version everywhere at once.
    -->
    <VersionFile>$([System.IO.Path]::Combine('$(MSBuildThisFileDirectory)', '..', '..', '.version'))</VersionFile>
    <VersionPrefix>$([System.IO.File]::ReadAllText($(VersionFile)).Trim())</VersionPrefix>
    <Product>ServiceHub</Product>
  </PropertyGroup>

  <PropertyGroup Condition="'$(IsTestProject)' == 'true'">
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
